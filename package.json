{
  "name": "arc",
  "version": "1.0.0",
  "private": true,
  "description": "Private Telegram-ingested media archive",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @arc/web",
    "build": "npm run build --workspace @arc/web",
    "lint": "npm run lint --workspace @arc/web",
    "typecheck": "npm run typecheck --workspace @arc/web && npm run typecheck --workspace @arc/worker",
    "telegram:webhook:set": "node scripts/set-telegram-webhook.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
